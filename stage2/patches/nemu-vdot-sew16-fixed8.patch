diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aae..71036b9b 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -19,6 +19,29 @@
 #include "vcompute_impl.h"
 #include "vcommon.h"
 
+// SKIProject 固定八项 e8/e16：精确求和，并完整覆盖 128 位目的寄存器。
+def_EHelper(vdot) {
+  require_vector(true);
+  if (vtype->vsew > 1 || vtype->vlmul != 0 || vl->val != 8 ||
+      !s->vm || vstart->val != 0) {
+    longjmp_exception(EX_II);
+  }
+  unsigned bits = 8u << vtype->vsew;
+  int64_t sum = 0;
+  for (int i = 0; i < 8; i++) {
+    uint32_t ua = bits == 8 ? vreg_b(id_src1->reg, i) : vreg_s(id_src1->reg, i);
+    uint32_t ub = bits == 8 ? vreg_b(id_src2->reg, i) : vreg_s(id_src2->reg, i);
+    int64_t a = ua < (1u << (bits - 1)) ? (int64_t)ua : (int64_t)ua - (1u << bits);
+    int64_t b = ub < (1u << (bits - 1)) ? (int64_t)ub : (int64_t)ub - (1u << bits);
+    sum += a * b;
+  }
+  // 所有源元素读取完毕后再写回，保证 vd 与 vs1/vs2 重叠时结果正确。
+  vreg_l(id_dest->reg, 0) = bits == 8 ? (uint64_t)(uint32_t)sum : (uint64_t)sum;
+  vreg_l(id_dest->reg, 1) = 0;
+  vstart->val = 0;
+  vp_set_dirty();
+}
+
 def_EHelper(vadd) {
   ARITH(ADD, SIGNED)
 }
diff --git a/src/isa/riscv64/system/intr.c b/src/isa/riscv64/system/intr.c
index e662cb1c..b4e6e888 100644
--- a/src/isa/riscv64/system/intr.c
+++ b/src/isa/riscv64/system/intr.c
@@ -70,6 +70,31 @@ static word_t get_trap_pc(word_t xtvec, word_t xcause) {
   return (is_intr && mode==1) ? (base + (cause_no << 2)) : base;
 }
 
+// 本项目的平台约定：DecodeStage 为译码阶段的非法 vdot 保存指令位。
+// 仅 VL 非法的异常在 VIMacU 执行阶段产生，此时 TrapInstMod
+// 未捕获该指令，因此当前处理器将 xtval 写为零。
+// 非法指令的 tval 允许为零；这里仍进行精确比较：
+// 不屏蔽 xtval，不禁用 CONFIG_TVAL_EX_II，也不修改标准指令行为。
+static word_t illegal_instruction_tval(void) {
+#ifdef CONFIG_TVAL_EX_II
+#ifdef CONFIG_RVV
+  bool vector_enabled = mstatus->vs != 0;
+#ifdef CONFIG_RVH
+  vector_enabled = vector_enabled && (!cpu.v || vsstatus->vs != 0);
+#endif
+  if ((cpu.instr & 0xfc00707fU) == 0x0000200bU &&
+      (cpu.instr & (1U << 25)) && vector_enabled && !vtype->vill &&
+      vtype->vsew <= 1 && vtype->vlmul == 0 && vstart->val == 0 &&
+      vl->val != 8) {
+    return 0;
+  }
+#endif
+  return cpu.instr;
+#else
+  return 0;
+#endif
+}
+
 word_t raise_intr(word_t NO, vaddr_t epc) {
   Logti("raise intr cause NO: %ld, epc: %lx\n", NO, epc);
 #ifdef CONFIG_DIFFTEST_REF_SPIKE
@@ -191,7 +216,7 @@ word_t raise_intr(word_t NO, vaddr_t epc) {
 #endif // CONFIG_RV_SDTRIG
         break;
       case EX_II:
-        vstval->val = MUXDEF(CONFIG_TVAL_EX_II, cpu.instr, 0);
+        vstval->val = illegal_instruction_tval();
         break;
       default: vstval->val = 0;
     }
@@ -230,7 +255,7 @@ word_t raise_intr(word_t NO, vaddr_t epc) {
       case EX_IGPF: case EX_LGPF: case EX_SGPF:
         break;
       case EX_II: case EX_VI:
-        stval->val = MUXDEF(CONFIG_TVAL_EX_II, cpu.instr, 0);
+        stval->val = illegal_instruction_tval();
         IFDEF(CONFIG_RVH, htval->val = 0);
         IFDEF(CONFIG_RVH, htinst->val = 0);
         break;
@@ -286,7 +311,7 @@ word_t raise_intr(word_t NO, vaddr_t epc) {
       case EX_IGPF: case EX_LGPF: case EX_SGPF:
         break;
       case EX_II: case EX_VI:
-        mtval->val = MUXDEF(CONFIG_TVAL_EX_II, cpu.instr, 0);
+        mtval->val = illegal_instruction_tval();
         IFDEF(CONFIG_RVH, mtval2->val = 0);
         IFDEF(CONFIG_RVH, mtinst->val = 0);
         break;
